# Copy to .env locally. Never put this key in VITE_* variables, chat, or browser storage.
OPENAI_API_KEY=

# Keep false until you approve paid API use and external transmission of your audio/text.
# A key alone never enables an external request.
TALK_SIMUL_ENABLE_PAID_API=false

# Official API model defaults checked on 2026-10-09. Account availability may vary.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
